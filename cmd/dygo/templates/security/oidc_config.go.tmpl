package {{.Pkg}}

import "strings"

// Config is read from the environment and .env.
type Config struct {
	IssuerURL   string `env:"OAUTH_ISSUER_URL"`                    // the identity provider, such as https://auth.example.com/realms/shop
	Audience    string `env:"OAUTH_AUDIENCE"`                      // this API's name at the provider; tokens must list it in "aud"
	RolesClaim  string `env:"OAUTH_ROLES_CLAIM" default:"roles"`   // the claim with the roles; Keycloak: realm_access.roles
	CORSOrigins string `env:"CORS_ALLOWED_ORIGINS"`                // browser origins allowed to call the API, comma separated
	AppEnv      string `env:"APP_ENV" default:"development"`
}

// Production reports whether APP_ENV is production.
func (c *Config) Production() bool { return c.AppEnv == "production" }

// Origins returns CORSOrigins as a list.
func (c *Config) Origins() []string {
	var out []string
	for _, o := range strings.Split(c.CORSOrigins, ",") {
		if o = strings.TrimSpace(o); o != "" {
			out = append(out, o)
		}
	}
	return out
}
