func TestRuleMatching(t *testing.T) {
	cfg := &{{.Pkg}}.Config{AppEnv: "production"}
	for _, r := range {{.Pkg}}.Rules(cfg) {
		if r.String() == "" {
			t.Fatal("rules describe themselves")
		}
	}
	if s := {{.Pkg}}.Path("/admin/**").HasRole("admin").String(); s != "/admin/** -> role:admin" {
		t.Fatalf("String() = %q", s)
	}
}
