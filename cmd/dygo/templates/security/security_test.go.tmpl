func TestProviderTokens(t *testing.T) {
	srv := newServer(t)
	provider := securitytest.Provider()
	valid := func() map[string]any {
		return provider.Claims({{.Pkg}}.Principal{Subject: "7", Roles: []string{"user"}})
	}
	get := func(token string) int {
		return srv.GET("/orders").Header("Authorization", "Bearer "+token).Do(t).StatusCode
	}
	if code := get(provider.Sign(valid())); code != 200 {
		t.Fatalf("valid token: %d", code)
	}
	now := time.Now()
	for name, edit := range map[string]func(map[string]any){
		"other issuer":   func(c map[string]any) { c["iss"] = "https://evil.example.com" },
		"other audience": func(c map[string]any) { c["aud"] = "another-api" },
		"expired":        func(c map[string]any) { c["exp"] = now.Add(-time.Hour).Unix() },
		"no expiry":      func(c map[string]any) { delete(c, "exp") },
		"not valid yet":  func(c map[string]any) { c["nbf"] = now.Add(time.Hour).Unix() },
		"no subject":     func(c map[string]any) { delete(c, "sub") },
	} {
		c := valid()
		edit(c)
		if code := get(provider.Sign(c)); code != 401 {
			t.Errorf("%s: %d, want 401", name, code)
		}
	}
	// The audience may be a list.
	c := valid()
	c["aud"] = []string{"another-api", securitytest.Audience}
	if code := get(provider.Sign(c)); code != 200 {
		t.Errorf("audience list: %d", code)
	}

	// Forged tokens: no signature, HS256 with the public key, a changed payload.
	token := provider.Sign(valid())
	header, rest, _ := strings.Cut(token, ".")
	payload, _, _ := strings.Cut(rest, ".")
	b := base64.RawURLEncoding
	h, _ := b.DecodeString(header)
	hs256 := strings.Replace(string(h), `"RS256"`, `"HS256"`, 1) // same key ID, other algorithm
	admin := b.EncodeToString([]byte(`{"iss":"` + provider.URL + `","aud":"` + securitytest.Audience + `","sub":"7","roles":["admin"],"exp":9999999999}`))
	for name, forged := range map[string]string{
		"alg none":        b.EncodeToString([]byte(`{"alg":"none"}`)) + "." + payload + ".",
		"HS256":           b.EncodeToString([]byte(hs256)) + "." + payload + "." + b.EncodeToString([]byte("sig")),
		"changed payload": header + "." + admin + "." + strings.SplitN(token, ".", 3)[2],
	} {
		if code := get(forged); code != 401 {
			t.Errorf("%s: %d, want 401", name, code)
		}
	}
}

// TestUnknownKeyFetchLimit sends tokens with made up key IDs: the app may
// fetch the provider's keys again once, not for every token, so it cannot
// be used to flood the provider (OWASP A10).
func TestUnknownKeyFetchLimit(t *testing.T) {
	srv := newServer(t)
	provider := securitytest.Provider()
	srv.GET("/orders").With(securitytest.User("7", "user")).Do(t).Status(t, 200)
	before := provider.KeyFetches()
	_, rest, _ := strings.Cut(securitytest.Token({{.Pkg}}.Principal{Subject: "7", Roles: []string{"user"}}), ".")
	b := base64.RawURLEncoding
	for i := range 20 {
		header := b.EncodeToString(fmt.Appendf(nil, `{"alg":"RS256","typ":"JWT","kid":"made-up-%d"}`, i))
		srv.GET("/orders").Header("Authorization", "Bearer "+header+"."+rest).Do(t).Status(t, 401)
	}
	if n := provider.KeyFetches() - before; n > 1 {
		t.Fatalf("%d key fetches for 20 unknown key IDs, want at most 1", n)
	}
}

func TestKeyRotation(t *testing.T) {
	srv := newServer(t)
	provider := securitytest.Provider()
	srv.GET("/orders").With(securitytest.User("7", "user")).Do(t).Status(t, 200)
	provider.RotateKey() // a token with a new key ID makes the app fetch the keys again
	srv.GET("/orders").With(securitytest.User("7", "user")).Do(t).Status(t, 200)
}

func TestClaimMapping(t *testing.T) {
	srv := newServer(t)
	writer := {{.Pkg}}.Principal{Subject: "7", Authorities: []string{"orders:write", "orders:read"}}
	srv.PUT("/orders/1").With(securitytest.As(writer)).Do(t).Status(t, 200) // scopes are authorities

	var me {{.Pkg}}.Principal
	srv.GET("/auth/me").With(securitytest.User("7", "user")).Do(t).Status(t, 200).JSON(t, &me)
	if me.Subject != "7" || !me.HasRole("user") {
		t.Fatalf("me %+v", me)
	}

	// Keycloak keeps roles in realm_access.roles.
	securitytest.Setup(t)
	provider := securitytest.Provider()
	v, err := {{.Pkg}}.NewVerifier(context.Background(), &{{.Pkg}}.Config{IssuerURL: provider.URL, Audience: securitytest.Audience, RolesClaim: "realm_access.roles"}, dygo.Optional[*slog.Logger]{})
	if err != nil {
		t.Fatal(err)
	}
	c := provider.Claims({{.Pkg}}.Principal{Subject: "7"})
	c["realm_access"] = map[string]any{"roles": []string{"admin"}}
	c["scp"] = []string{"orders:cancel"}
	p, err := v.Verify(context.Background(), provider.Sign(c))
	if err != nil || !p.HasRole("admin") || !p.HasAuthority("orders:cancel") || p.Claims["realm_access"] == nil {
		t.Fatalf("Verify = %+v, %v", p, err)
	}
}
