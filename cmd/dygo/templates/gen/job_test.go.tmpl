package {{.Pkg}}

import (
	"context"
	"testing"
	"time"

	"{{.Framework}}/queue"
)

func TestProcessor(t *testing.T) {
	mem := queue.NewMemory(queue.MemoryOptions{})
	q := queue.New(queue.Options{Driver: mem})
	if err := q.Register(NewProcessor()); err != nil {
		t.Fatal(err)
	}
	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
	defer cancel()
	if _, err := q.Add(ctx, JobName, Payload{ID: "1"}); err != nil {
		t.Fatal(err)
	}
	if err := q.Start(); err != nil {
		t.Fatal(err)
	}
	defer q.Stop(ctx)
	if err := mem.Wait(ctx); err != nil {
		t.Fatal(err)
	}
	if f := mem.Failed(); len(f) > 0 {
		t.Fatalf("job failed: %v", f[0].Err)
	}
}
