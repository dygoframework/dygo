package {{.Pkg}}

import (
	"context"
	"errors"
	"fmt"

	"{{.Framework}}/errs"
	"{{.Framework}}/sql"
)

// Service stores {{.Kebab}} in the database set by DATABASE_URL in
// .env: memory:// keeps them in memory, a Postgres or MySQL URL in that
// database (create the table with dygo g migration and dygo db migrate).
type Service struct {
	repo *sql.Repository[{{.Entity}}]
}

// NewService is the constructor.
func NewService(repo *sql.Repository[{{.Entity}}]) *Service {
	return &Service{repo: repo}
}

// List returns every {{.Entity}} by ID.
func (s *Service) List(ctx context.Context) ([]{{.Entity}}, error) {
	return s.repo.List(ctx, sql.OrderBy("id"))
}

// Get returns one {{.Entity}}, or a 404 error.
func (s *Service) Get(ctx context.Context, id int) ({{.Entity}}, error) {
	{{.Var}}, err := s.repo.Find(ctx, id)
	return {{.Var}}, notFound(id, err)
}

// Create stores a new {{.Entity}}.
func (s *Service) Create(ctx context.Context, in Create{{.Entity}}) ({{.Entity}}, error) {
	{{.Var}} := in.Entity(0)
	err := s.repo.Create(ctx, &{{.Var}})
	return {{.Var}}, err
}

// Update changes the fields set in in.
func (s *Service) Update(ctx context.Context, id int, in Update{{.Entity}}) ({{.Entity}}, error) {
	{{.Var}}, err := s.Get(ctx, id)
	if err != nil {
		return {{.Entity}}{}, err
	}
	in.Apply(&{{.Var}})
	return {{.Var}}, notFound(id, s.repo.Update(ctx, &{{.Var}}))
}

// Delete removes the {{.Entity}} with id.
func (s *Service) Delete(ctx context.Context, id int) error {
	return notFound(id, s.repo.Delete(ctx, id))
}

// notFound names the {{.Entity}} in a not found error.
func notFound(id int, err error) error {
	if errors.Is(err, sql.ErrNotFound) {
		return errs.NotFound(fmt.Sprintf("{{.Entity}} %d not found", id))
	}
	return err
}
