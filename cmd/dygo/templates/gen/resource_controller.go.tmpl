package {{.Pkg}}

import (
	"context"

	"{{.Framework}}"
{{- if .Sec.UsesSec}}

	"{{.Sec.ImportPath}}"
{{- end}}
)

// Controller maps /{{.Kebab}} to the service.
type Controller struct {
	svc *Service
}

// NewController is the constructor.
func NewController(svc *Service) *Controller {
	return &Controller{svc: svc}
}

// Routes registers the CRUD routes.
func (c *Controller) Routes(r dygo.Router) {
	r = r.Prefix("/{{.Kebab}}")
	r.Get("/", dygo.HandleNoInput(c.List){{with .Sec}}{{.ReadOption}}{{end}})
	r.Get("/{id}", dygo.Handle(c.Get){{with .Sec}}{{.ReadOption}}{{end}})
	r.Post("/", dygo.Handle(c.Create){{with .Sec}}{{.WriteOption}}{{end}})
	r.Patch("/{id}", dygo.Handle(c.Update){{with .Sec}}{{.WriteOption}}{{end}})
	r.Delete("/{id}", dygo.Handle(c.Delete){{with .Sec}}{{.WriteOption}}{{end}})
}

// IDIn is the {id} path parameter.
type IDIn struct {
	ID int `path:"id"`
}

// CreateIn is the input of POST /{{.Kebab}}.
type CreateIn struct {
	Body Create{{.Entity}} `body:"json"`
}

// UpdateIn is the input of PATCH /{{.Kebab}}/{id}.
type UpdateIn struct {
	ID   int            `path:"id"`
	Body Update{{.Entity}} `body:"json"`
}

// List answers GET /{{.Kebab}}.
func (c *Controller) List(ctx context.Context) ([]{{.Entity}}, error) {
	return c.svc.List(ctx)
}

// Get answers GET /{{.Kebab}}/{id}.
func (c *Controller) Get(ctx context.Context, in IDIn) ({{.Entity}}, error) {
	return c.svc.Get(ctx, in.ID)
}

// Create answers POST /{{.Kebab}} with 201.
func (c *Controller) Create(ctx context.Context, in CreateIn) ({{.Entity}}, error) {
	return c.svc.Create(ctx, in.Body)
}

// Update answers PATCH /{{.Kebab}}/{id}.
func (c *Controller) Update(ctx context.Context, in UpdateIn) ({{.Entity}}, error) {
	return c.svc.Update(ctx, in.ID, in.Body)
}

// Delete answers DELETE /{{.Kebab}}/{id} with 204.
func (c *Controller) Delete(ctx context.Context, in IDIn) (dygo.NoContent, error) {
	return dygo.NoContent{}, c.svc.Delete(ctx, in.ID)
}
