package {{.Pkg}}

import (
	"context"

	"{{.Framework}}"
{{- if and .Sec .Sec.Public}}

	"{{.Sec.ImportPath}}"
{{- end}}
)

// Controller serves /{{.Kebab}}.
type Controller struct{}

// NewController is the constructor. Add dependencies as parameters.
func NewController() *Controller {
	return &Controller{}
}

// Routes registers the routes.
func (c *Controller) Routes(r dygo.Router) {
	r = r.Prefix("/{{.Kebab}}")
	r.Get("/", dygo.HandleNoInput(c.Hello){{if and .Sec .Sec.Public}}, {{.Sec.Pkg}}.Public(){{end}})
}

// HelloOut is the response of GET /{{.Kebab}}.
type HelloOut struct {
	Message string `json:"message"`
}

// Hello answers GET /{{.Kebab}}.
func (c *Controller) Hello(context.Context) (HelloOut, error) {
	return HelloOut{Message: "hello from {{.Kebab}}"}, nil
}
