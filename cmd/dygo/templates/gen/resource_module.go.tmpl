{{if not .FlatPkg}}// Package {{.Pkg}} is the {{.Kebab}} resource: a service and a CRUD controller.
{{end -}}
package {{.Package}}

import (
	"{{.Framework}}"
	"{{.Framework}}/sql"
)

// {{.P}}Module wires the {{.Kebab}} resource, stored in the {{.Table}} table.
// Other modules that import it can inject *{{.P}}Service.
var {{.P}}Module = &dygo.Module{
	Name:        "{{.Kebab}}",
	Providers:   []dygo.Provider{sql.ForFeature[{{.Entity}}]("{{.Table}}"), dygo.Provide(New{{.P}}Service)},
	Controllers: []dygo.Provider{dygo.Provide(New{{.P}}Controller)},
	Exports:     []dygo.Token{dygo.TypeOf[*{{.P}}Service]()},
}
