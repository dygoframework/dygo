package main

import (
	"log/slog"
	"testing"

	"{{.Framework}}"
	"{{.Framework}}/config"
	"{{.Framework}}/dygotest"
)

func testApp(t *testing.T) *dygotest.Server {
	t.Helper()
	cfg, err := config.Load[Config](config.Env(map[string]string{}))
	if err != nil {
		t.Fatal(err)
	}
	log := slog.New(slog.DiscardHandler)
	return dygotest.New(AppModule(cfg, log)).With(Options(cfg, log)...).CompileHTTP(t)
}

// TestWiring validates the module graph without building anything.
func TestWiring(t *testing.T) {
	if _, err := dygo.Describe(AppModule(&Config{}, slog.New(slog.DiscardHandler))); err != nil {
		t.Fatal(err)
	}
}

func TestHello(t *testing.T) {
	srv := testApp(t)
	var msg Message
	srv.GET("/").Do(t).Status(t, 200).JSON(t, &msg)
	if msg.Message != "Hello World!" {
		t.Fatalf("got %q", msg.Message)
	}
	srv.GET("/health/live").Do(t).Status(t, 200)
}
