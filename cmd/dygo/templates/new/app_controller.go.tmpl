package main

import (
	"context"

	"{{.Framework}}"
)

// AppController serves the root path.
type AppController struct{}

// NewAppController is the constructor.
func NewAppController() *AppController { return &AppController{} }

// Routes registers the controller's routes.
func (c *AppController) Routes(r dygo.Router) {
	r.Get("/", dygo.HandleNoInput(c.Hello))
}

// Message is a JSON message.
type Message struct {
	Message string `json:"message"`
}

// Hello answers GET /.
func (c *AppController) Hello(context.Context) (Message, error) {
	return Message{Message: "Hello World!"}, nil
}
