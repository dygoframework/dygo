# Port the HTTP server listens on: http://localhost:9900
PORT=9900

# How much to log: debug, info, warn or error
LOG_LEVEL=info

# Database connection. memory:// keeps the data in memory, so it is lost when
# the app stops; dygo db init puts your Postgres or MySQL URL here.
DATABASE_URL=memory://

# Uncomment for JSON logs, as in production (the Docker image sets it)
# APP_ENV=production
