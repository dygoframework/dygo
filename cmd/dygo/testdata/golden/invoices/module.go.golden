// Package invoices is the invoices resource: a service and a CRUD controller.
package invoices

import (
	"github.com/dygoframework/dygo"
	"github.com/dygoframework/dygo/sql"
)

// Module wires the invoices resource, stored in the invoices table.
// Other modules that import it can inject *Service.
var Module = &dygo.Module{
	Name:        "invoices",
	Providers:   []dygo.Provider{sql.ForFeature[Invoice]("invoices"), dygo.Provide(NewService)},
	Controllers: []dygo.Provider{dygo.Provide(NewController)},
	Exports:     []dygo.Token{dygo.TypeOf[*Service]()},
}
