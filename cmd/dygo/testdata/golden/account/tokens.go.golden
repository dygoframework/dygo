package account

import (
	"crypto/hmac"
	"crypto/rand"
	"crypto/sha256"
	"encoding/base64"
	"encoding/json"
	"errors"
	"log/slog"
	"strconv"
	"strings"
	"time"
)

// Claims is what an access token says about its user.
type Claims struct {
	Subject   string   `json:"sub"`
	Email     string   `json:"email"`
	Roles     []string `json:"roles"`
	IssuedAt  int64    `json:"iat"`
	ExpiresAt int64    `json:"exp"`
}

// UserID is the user's ID.
func (c Claims) UserID() int {
	id, _ := strconv.Atoi(c.Subject)
	return id
}

// Tokens issues and verifies access tokens: JWTs signed with HMAC-SHA256.
type Tokens struct {
	secret []byte
	ttl    time.Duration
	now    func() time.Time
}

// NewTokens reads the secret from cfg. Without one it makes a random secret,
// so tokens stop working on restart, except in production, where it fails.
func NewTokens(cfg *Config) (*Tokens, error) {
	secret := []byte(cfg.Secret)
	switch {
	case len(secret) == 0 && cfg.AppEnv == "production":
		return nil, errors.New("AUTH_SECRET is required in production")
	case len(secret) == 0:
		secret = make([]byte, 32)
		if _, err := rand.Read(secret); err != nil {
			return nil, err
		}
		slog.Warn("AUTH_SECRET is not set; using a random secret, so tokens stop working on restart")
	case len(secret) < 32:
		return nil, errors.New("AUTH_SECRET must be at least 32 characters")
	}
	return &Tokens{secret: secret, ttl: cfg.TokenTTL, now: time.Now}, nil
}

var (
	b64        = base64.RawURLEncoding
	jwtHeader  = b64.EncodeToString([]byte(`{"alg":"HS256","typ":"JWT"}`))
	errBadAuth = errors.New("invalid token")
)

// Issue returns a token for u and when it expires.
func (t *Tokens) Issue(u User) (string, time.Time, error) {
	now := t.now()
	exp := now.Add(t.ttl)
	payload, err := json.Marshal(Claims{
		Subject: strconv.Itoa(u.ID), Email: u.Email, Roles: u.Roles,
		IssuedAt: now.Unix(), ExpiresAt: exp.Unix(),
	})
	if err != nil {
		return "", time.Time{}, err
	}
	unsigned := jwtHeader + "." + b64.EncodeToString(payload)
	return unsigned + "." + t.sign(unsigned), exp, nil
}

// Verify checks the signature and the expiry, and returns the claims.
func (t *Tokens) Verify(token string) (Claims, error) {
	header, rest, ok1 := strings.Cut(token, ".")
	payload, sig, ok2 := strings.Cut(rest, ".")
	if !ok1 || !ok2 || header != jwtHeader {
		return Claims{}, errBadAuth
	}
	if !hmac.Equal([]byte(sig), []byte(t.sign(header+"."+payload))) {
		return Claims{}, errBadAuth
	}
	data, err := b64.DecodeString(payload)
	if err != nil {
		return Claims{}, errBadAuth
	}
	var c Claims
	if err := json.Unmarshal(data, &c); err != nil {
		return Claims{}, errBadAuth
	}
	if t.now().Unix() >= c.ExpiresAt {
		return Claims{}, errors.New("token expired")
	}
	return c, nil
}

func (t *Tokens) sign(s string) string {
	m := hmac.New(sha256.New, t.secret)
	m.Write([]byte(s))
	return b64.EncodeToString(m.Sum(nil))
}
