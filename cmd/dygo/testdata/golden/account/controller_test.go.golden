package account

import (
	"testing"

	"github.com/dygoframework/dygo"
	"github.com/dygoframework/dygo/dygotest"
	"github.com/dygoframework/dygo/validate"
)

func TestAuth(t *testing.T) {
	srv := dygotest.New(&dygo.Module{Name: "app", Imports: []*dygo.Module{Module}}).
		With(validate.Use(validate.Methods())).CompileHTTP(t)
	creds := Credentials{Email: "ada@example.com", Password: "correct horse battery"}

	var u User
	srv.POST("/account/register").JSON(creds).Do(t).Status(t, 201).JSON(t, &u)
	if u.ID == 0 || u.Email != creds.Email {
		t.Fatalf("registered %+v", u)
	}
	srv.POST("/account/register").JSON(creds).Do(t).Status(t, 409)
	srv.POST("/account/register").JSON(Credentials{Email: "nope", Password: "short"}).Do(t).Status(t, 400)

	srv.POST("/account/login").JSON(Credentials{Email: creds.Email, Password: "wrong password"}).Do(t).Status(t, 401)
	var tok TokenOut
	srv.POST("/account/login").JSON(creds).Do(t).Status(t, 200).JSON(t, &tok)

	srv.GET("/account/me").Do(t).Status(t, 401)
	srv.GET("/account/me").Header("Authorization", "Bearer "+tok.AccessToken+"x").Do(t).Status(t, 401)
	var me User
	srv.GET("/account/me").Header("Authorization", "Bearer "+tok.AccessToken).Do(t).Status(t, 200).JSON(t, &me)
	if me.ID != u.ID {
		t.Fatalf("me %+v", me)
	}
}
