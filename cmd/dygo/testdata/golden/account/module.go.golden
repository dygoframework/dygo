// Package account is authentication: register, log in for an access token,
// and a guard for the routes that need a signed in user.
//
//	r.Get("/orders", dygo.HandleNoInput(c.List), account.Required())
//	r.Delete("/{id}", dygo.Handle(c.Delete), account.Roles("admin"))
//	claims, _ := account.UserFrom(ctx)
//
// Users are kept in memory; replace Users with your database. Set
// AUTH_SECRET in .env (it is required when APP_ENV=production).
package account

import (
	"github.com/dygoframework/dygo"
	"github.com/dygoframework/dygo/config"
)

// Module is global, so every module can protect its routes with Required and
// Roles, and inject *Service.
var Module = &dygo.Module{
	Name:    "account",
	Global:  true,
	Imports: []*dygo.Module{config.ForFeature[Config](config.Files(".env.local", ".env"))},
	Providers: []dygo.Provider{
		dygo.Provide(NewUsers),
		dygo.Provide(NewTokens),
		dygo.Provide(NewService),
		dygo.Provide(NewGuard),
	},
	Controllers: []dygo.Provider{dygo.Provide(NewController)},
	Exports:     []dygo.Token{dygo.TypeOf[*Service](), dygo.TypeOf[*Guard]()},
}
