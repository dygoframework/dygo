package seeddata

import (
	"context"
	"fmt"
)

// Command is the seed-data console command: dygo run seed-data [args].
// It runs inside the application context, so add the services it needs as
// parameters of NewCommand.
type Command struct{}

// NewCommand is the constructor.
func NewCommand() *Command {
	return &Command{}
}

// Name selects the command on the command line.
func (c *Command) Name() string { return "seed-data" }

// Description is shown by dygo run, which lists the commands.
func (c *Command) Description() string { return "TODO: describe seed-data" }

// Run does the work. ctx is cancelled on Ctrl+C.
func (c *Command) Run(ctx context.Context, args []string) error {
	fmt.Println("seed-data: args", args)
	return nil
}
