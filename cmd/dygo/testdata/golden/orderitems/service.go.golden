package orderitems

import (
	"context"
	"errors"
	"fmt"

	"github.com/dygoframework/dygo/errs"
	"github.com/dygoframework/dygo/sql"
)

// Service stores order-items in the database set by DATABASE_URL in
// .env: memory:// keeps them in memory, a Postgres or MySQL URL in that
// database (create the table with dygo g migration and dygo db migrate).
type Service struct {
	repo *sql.Repository[OrderItem]
}

// NewService is the constructor.
func NewService(repo *sql.Repository[OrderItem]) *Service {
	return &Service{repo: repo}
}

// List returns every OrderItem by ID.
func (s *Service) List(ctx context.Context) ([]OrderItem, error) {
	return s.repo.List(ctx, sql.OrderBy("id"))
}

// Get returns one OrderItem, or a 404 error.
func (s *Service) Get(ctx context.Context, id int) (OrderItem, error) {
	orderItem, err := s.repo.Find(ctx, id)
	return orderItem, notFound(id, err)
}

// Create stores a new OrderItem.
func (s *Service) Create(ctx context.Context, in CreateOrderItem) (OrderItem, error) {
	orderItem := in.Entity(0)
	err := s.repo.Create(ctx, &orderItem)
	return orderItem, err
}

// Update changes the fields set in in.
func (s *Service) Update(ctx context.Context, id int, in UpdateOrderItem) (OrderItem, error) {
	orderItem, err := s.Get(ctx, id)
	if err != nil {
		return OrderItem{}, err
	}
	in.Apply(&orderItem)
	return orderItem, notFound(id, s.repo.Update(ctx, &orderItem))
}

// Delete removes the OrderItem with id.
func (s *Service) Delete(ctx context.Context, id int) error {
	return notFound(id, s.repo.Delete(ctx, id))
}

// notFound names the OrderItem in a not found error.
func notFound(id int, err error) error {
	if errors.Is(err, sql.ErrNotFound) {
		return errs.NotFound(fmt.Sprintf("OrderItem %d not found", id))
	}
	return err
}
