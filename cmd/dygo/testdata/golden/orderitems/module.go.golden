// Package orderitems is the order-items resource: a service and a CRUD controller.
package orderitems

import (
	"github.com/dygoframework/dygo"
	"github.com/dygoframework/dygo/sql"
)

// Module wires the order-items resource, stored in the order_items table.
// Other modules that import it can inject *Service.
var Module = &dygo.Module{
	Name:        "order-items",
	Providers:   []dygo.Provider{sql.ForFeature[OrderItem]("order_items"), dygo.Provide(NewService)},
	Controllers: []dygo.Provider{dygo.Provide(NewController)},
	Exports:     []dygo.Token{dygo.TypeOf[*Service]()},
}
