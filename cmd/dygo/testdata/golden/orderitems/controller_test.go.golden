package orderitems

import (
	"testing"

	"github.com/dygoframework/dygo"
	"github.com/dygoframework/dygo/dygotest"
	"github.com/dygoframework/dygo/sql"
	"github.com/dygoframework/dygo/validate"

	"time"
)

func TestCRUD(t *testing.T) {
	app := &dygo.Module{Name: "test", Imports: []*dygo.Module{sql.MemoryModule(), Module}}
	srv := dygotest.New(app).With(validate.Use(validate.Methods())).CompileHTTP(t)

	var created OrderItem
	srv.POST("/order-items").JSON(CreateOrderItem{
		Name:    "name 1",
		Qty:     1,
		Note:    "note 1",
		Contact: "ada@example.com",
		Due:     time.Date(2026, 1, 2, 3, 4, 5, 0, time.UTC),
	}).Do(t).Status(t, 201).JSON(t, &created)
	if created.ID == 0 {
		t.Fatalf("created %+v", created)
	}
	srv.POST("/order-items").JSON(CreateOrderItem{}).Do(t).Status(t, 400)

	var list []OrderItem
	srv.GET("/order-items").Do(t).Status(t, 200).JSON(t, &list)
	if len(list) != 1 {
		t.Fatalf("list %+v", list)
	}

	name := "changed"
	var updated OrderItem
	srv.PATCH("/order-items/1").JSON(UpdateOrderItem{Name: &name}).Do(t).Status(t, 200).JSON(t, &updated)
	if updated.Name != name {
		t.Fatalf("updated %+v", updated)
	}

	srv.DELETE("/order-items/1").Do(t).Status(t, 204)
	srv.GET("/order-items/1").Do(t).Status(t, 404)
	srv.GET("/order-items/abc").Do(t).Status(t, 400)
}
