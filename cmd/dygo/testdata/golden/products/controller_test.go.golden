package products

import (
	"testing"

	"github.com/dygoframework/dygo"
	"github.com/dygoframework/dygo/dygotest"
	"github.com/dygoframework/dygo/sql"
	"github.com/dygoframework/dygo/validate"
)

func TestCRUD(t *testing.T) {
	app := &dygo.Module{Name: "test", Imports: []*dygo.Module{sql.MemoryModule(), Module}}
	srv := dygotest.New(app).With(validate.Use(validate.Methods())).CompileHTTP(t)

	var created Product
	srv.POST("/products").JSON(CreateProduct{
		Title: "title 1",
		Price: 1.5,
		Tags:  "tags 1",
		Owner: "ada@example.com",
	}).Do(t).Status(t, 201).JSON(t, &created)
	if created.ID == 0 {
		t.Fatalf("created %+v", created)
	}
	srv.POST("/products").JSON(CreateProduct{}).Do(t).Status(t, 400)

	var list []Product
	srv.GET("/products").Do(t).Status(t, 200).JSON(t, &list)
	if len(list) != 1 {
		t.Fatalf("list %+v", list)
	}

	title := "changed"
	var updated Product
	srv.PATCH("/products/1").JSON(UpdateProduct{Title: &title}).Do(t).Status(t, 200).JSON(t, &updated)
	if updated.Title != title {
		t.Fatalf("updated %+v", updated)
	}

	srv.DELETE("/products/1").Do(t).Status(t, 204)
	srv.GET("/products/1").Do(t).Status(t, 404)
	srv.GET("/products/abc").Do(t).Status(t, 400)
}
