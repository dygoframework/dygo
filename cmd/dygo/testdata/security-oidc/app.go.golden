package main

import (
	"github.com/dygoframework/dygo"
	"github.com/dygoframework/dygo/middleware"
	"github.com/dygoframework/dygo/openapi"

	"example.com/app/security"
)

// AppModule is the root module.
func AppModule() *dygo.Module {
	return &dygo.Module{
		Name: "app",
		Imports: []*dygo.Module{
			openapi.Module(openapi.Options{BearerAuth: true, Info: openapi.Info{Title: "app", Version: "0.1.0"}}),
			security.Module,
		},
	}
}

// Options are the application options.
func Options() []dygo.Option {
	return []dygo.Option{
		dygo.WithMiddleware(
			middleware.SecureHeaders(middleware.SecureHeadersOptions{}),
			security.CORS(),
			middleware.RequestID(),
		),
	}
}
