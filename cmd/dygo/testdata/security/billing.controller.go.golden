package main

import (
	"context"

	"github.com/dygoframework/dygo"
)

// BillingController serves /billing.
type BillingController struct{}

// NewBillingController is the constructor. Add dependencies as parameters.
func NewBillingController() *BillingController {
	return &BillingController{}
}

// Routes registers the routes.
func (c *BillingController) Routes(r dygo.Router) {
	r = r.Prefix("/billing")
	r.Get("/", dygo.HandleNoInput(c.Hello))
}

// BillingHelloOut is the response of GET /billing.
type BillingHelloOut struct {
	Message string `json:"message"`
}

// Hello answers GET /billing.
func (c *BillingController) Hello(context.Context) (BillingHelloOut, error) {
	return BillingHelloOut{Message: "hello from billing"}, nil
}
