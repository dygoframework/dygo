CREATE security/module.go
CREATE security/config.go
CREATE security/rules.go
CREATE security/rule.go
CREATE security/guard.go
CREATE security/principal.go
CREATE security/roles.go
CREATE security/authorize.go
CREATE security/cors.go
CREATE security/users.go
CREATE security/password.go
CREATE security/tokens.go
CREATE security/tokencache.go
CREATE security/refresh.go
CREATE security/service.go
CREATE security/dto.go
CREATE security/controller.go
CREATE security/security_test.go
CREATE security/securitytest/securitytest.go
UPDATE app.go (Imports += security.Module)
UPDATE .env.example (AUTH_SECRET, AUTH_TOKEN_TTL, AUTH_REFRESH_TTL, CORS_ALLOWED_ORIGINS)
UPDATE app.go (Imports += sql.Module(nil): the database in DATABASE_URL)

Run go mod tidy to add github.com/dygoframework/dygo/sql to go.mod.
UPDATE dygo.json ("security": true)
UPDATE app.go (dygo.WithMiddleware += security.CORS())
UPDATE app.go (dygo.WithMiddleware += middleware.SecureHeaders(middleware.SecureHeadersOptions{}))
UPDATE app.go (openapi.Options += BearerAuth: true)

Every route now needs a bearer token, unless security/rules.go or security.Public() opens it.
Next:
  AUTH_SECRET:      .env has a random one; use your own in production   # openssl rand -hex 32
  POST /auth/register, POST /auth/login, POST /auth/refresh, POST /auth/logout, GET /auth/me
  with a database:  dygo g migration, add CREATE UNIQUE INDEX users_email ON users (email);
                    then dygo db migrate   # tables users, refresh_tokens, refresh_families
  open a route:     r.Get("/", h, security.Public())
  need a role:      r.Delete("/{id}", h, security.Roles("admin"))
  in a service:     err := security.Require(ctx, security.HasAuthority("orders:cancel"))
  read the user:    p, _ := security.CurrentUser(ctx)
  in tests:         securitytest.Setup(t); srv.GET("/x").With(securitytest.User("7", "user"))
CREATE products/module.go
CREATE products/products.go
CREATE products/service.go
CREATE products/controller.go
CREATE products/controller_test.go
UPDATE app.go (Imports += products.Module)

Run go mod tidy to add github.com/dygoframework/dygo/sql to go.mod.

 Success! CRUD for Product:

   GET    /products          List    (index)
   POST   /products          Create  (new)
   GET    /products/{id}     Get     (show)
   PATCH  /products/{id}     Update  (edit)
   DELETE /products/{id}     Delete  (delete)

 Next: go test ./... and dygo routes; try them at /docs.

Security: list and get need a signed in user; create, update and delete need the admin role. Change it with -public-read, -write-role or security/rules.go.
