package main

import (
	"github.com/dygoframework/dygo"
	"github.com/dygoframework/dygo/sql"
)

// PostsModule wires the posts resource, stored in the posts table.
// Other modules that import it can inject *PostsService.
var PostsModule = &dygo.Module{
	Name:        "posts",
	Providers:   []dygo.Provider{sql.ForFeature[Post]("posts"), dygo.Provide(NewPostsService)},
	Controllers: []dygo.Provider{dygo.Provide(NewPostsController)},
	Exports:     []dygo.Token{dygo.TypeOf[*PostsService]()},
}
