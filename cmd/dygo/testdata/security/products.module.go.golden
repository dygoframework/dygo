package main

import (
	"github.com/dygoframework/dygo"
	"github.com/dygoframework/dygo/sql"
)

// ProductsModule wires the products resource, stored in the products table.
// Other modules that import it can inject *ProductsService.
var ProductsModule = &dygo.Module{
	Name:        "products",
	Providers:   []dygo.Provider{sql.ForFeature[Product]("products"), dygo.Provide(NewProductsService)},
	Controllers: []dygo.Provider{dygo.Provide(NewProductsController)},
	Exports:     []dygo.Token{dygo.TypeOf[*ProductsService]()},
}
