package main

import (
	"context"

	"github.com/dygoframework/dygo"

	"example.com/app/security"
)

// PostsController maps /posts to the service.
type PostsController struct {
	svc *PostsService
}

// NewPostsController is the constructor.
func NewPostsController(svc *PostsService) *PostsController {
	return &PostsController{svc: svc}
}

// Routes registers the CRUD routes.
func (c *PostsController) Routes(r dygo.Router) {
	r = r.Prefix("/posts")
	r.Get("/", dygo.HandleNoInput(c.List), security.Public())
	r.Get("/{id}", dygo.Handle(c.Get), security.Public())
	r.Post("/", dygo.Handle(c.Create))
	r.Patch("/{id}", dygo.Handle(c.Update))
	r.Delete("/{id}", dygo.Handle(c.Delete))
}

// PostsIDIn is the {id} path parameter.
type PostsIDIn struct {
	ID int `path:"id"`
}

// PostsCreateIn is the input of POST /posts.
type PostsCreateIn struct {
	Body CreatePost `body:"json"`
}

// PostsUpdateIn is the input of PATCH /posts/{id}.
type PostsUpdateIn struct {
	ID   int        `path:"id"`
	Body UpdatePost `body:"json"`
}

// List answers GET /posts.
func (c *PostsController) List(ctx context.Context) ([]Post, error) {
	return c.svc.List(ctx)
}

// Get answers GET /posts/{id}.
func (c *PostsController) Get(ctx context.Context, in PostsIDIn) (Post, error) {
	return c.svc.Get(ctx, in.ID)
}

// Create answers POST /posts with 201.
func (c *PostsController) Create(ctx context.Context, in PostsCreateIn) (Post, error) {
	return c.svc.Create(ctx, in.Body)
}

// Update answers PATCH /posts/{id}.
func (c *PostsController) Update(ctx context.Context, in PostsUpdateIn) (Post, error) {
	return c.svc.Update(ctx, in.ID, in.Body)
}

// Delete answers DELETE /posts/{id} with 204.
func (c *PostsController) Delete(ctx context.Context, in PostsIDIn) (dygo.NoContent, error) {
	return dygo.NoContent{}, c.svc.Delete(ctx, in.ID)
}
