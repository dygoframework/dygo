// Package posts is the posts resource: a service and a CRUD controller.
package posts

import (
	"github.com/dygoframework/dygo"
	"github.com/dygoframework/dygo/sql"
)

// Module wires the posts resource, stored in the posts table.
// Other modules that import it can inject *Service.
var Module = &dygo.Module{
	Name:        "posts",
	Providers:   []dygo.Provider{sql.ForFeature[Post]("posts"), dygo.Provide(NewService)},
	Controllers: []dygo.Provider{dygo.Provide(NewController)},
	Exports:     []dygo.Token{dygo.TypeOf[*Service]()},
}
