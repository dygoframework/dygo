package posts

import (
	"testing"

	"github.com/dygoframework/dygo"
	"github.com/dygoframework/dygo/dygotest"
	"github.com/dygoframework/dygo/sql"
	"github.com/dygoframework/dygo/validate"

	"example.com/app/security"
	"example.com/app/security/securitytest"
)

func TestCRUD(t *testing.T) {
	securitytest.Setup(t)
	app := &dygo.Module{Name: "test", Imports: []*dygo.Module{sql.MemoryModule(), security.Module, Module}}
	srv := dygotest.New(app).With(validate.Use(validate.Methods())).CompileHTTP(t)
	reader := securitytest.User("2", "user")
	writer := reader

	// Security: who may call what.
	srv.GET("/posts").Do(t).Status(t, 200)
	srv.POST("/posts").JSON(CreatePost{}).Do(t).Status(t, 401)

	var created Post
	srv.POST("/posts").With(writer).JSON(CreatePost{
		Name: "name 1",
	}).Do(t).Status(t, 201).JSON(t, &created)
	if created.ID == 0 {
		t.Fatalf("created %+v", created)
	}
	srv.POST("/posts").With(writer).JSON(CreatePost{}).Do(t).Status(t, 400)

	var list []Post
	srv.GET("/posts").Do(t).Status(t, 200).JSON(t, &list)
	if len(list) != 1 {
		t.Fatalf("list %+v", list)
	}

	name := "changed"
	var updated Post
	srv.PATCH("/posts/1").With(writer).JSON(UpdatePost{Name: &name}).Do(t).Status(t, 200).JSON(t, &updated)
	if updated.Name != name {
		t.Fatalf("updated %+v", updated)
	}

	srv.DELETE("/posts/1").With(writer).Do(t).Status(t, 204)
	srv.GET("/posts/1").Do(t).Status(t, 404)
	srv.GET("/posts/abc").Do(t).Status(t, 400)
}
