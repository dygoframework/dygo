package posts

import (
	"context"

	"github.com/dygoframework/dygo"

	"example.com/app/security"
)

// Controller maps /posts to the service.
type Controller struct {
	svc *Service
}

// NewController is the constructor.
func NewController(svc *Service) *Controller {
	return &Controller{svc: svc}
}

// Routes registers the CRUD routes.
func (c *Controller) Routes(r dygo.Router) {
	r = r.Prefix("/posts")
	r.Get("/", dygo.HandleNoInput(c.List), security.Public())
	r.Get("/{id}", dygo.Handle(c.Get), security.Public())
	r.Post("/", dygo.Handle(c.Create))
	r.Patch("/{id}", dygo.Handle(c.Update))
	r.Delete("/{id}", dygo.Handle(c.Delete))
}

// IDIn is the {id} path parameter.
type IDIn struct {
	ID int `path:"id"`
}

// CreateIn is the input of POST /posts.
type CreateIn struct {
	Body CreatePost `body:"json"`
}

// UpdateIn is the input of PATCH /posts/{id}.
type UpdateIn struct {
	ID   int        `path:"id"`
	Body UpdatePost `body:"json"`
}

// List answers GET /posts.
func (c *Controller) List(ctx context.Context) ([]Post, error) {
	return c.svc.List(ctx)
}

// Get answers GET /posts/{id}.
func (c *Controller) Get(ctx context.Context, in IDIn) (Post, error) {
	return c.svc.Get(ctx, in.ID)
}

// Create answers POST /posts with 201.
func (c *Controller) Create(ctx context.Context, in CreateIn) (Post, error) {
	return c.svc.Create(ctx, in.Body)
}

// Update answers PATCH /posts/{id}.
func (c *Controller) Update(ctx context.Context, in UpdateIn) (Post, error) {
	return c.svc.Update(ctx, in.ID, in.Body)
}

// Delete answers DELETE /posts/{id} with 204.
func (c *Controller) Delete(ctx context.Context, in IDIn) (dygo.NoContent, error) {
	return dygo.NoContent{}, c.svc.Delete(ctx, in.ID)
}
