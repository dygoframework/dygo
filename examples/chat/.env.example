# Copy to .env. Switching vendors is a change here, not in code.
AI_PROVIDER=openai          # or anthropic
AI_MODEL=gpt-5              # the vendor's model id
AI_API_KEY=                 # never logged
# A local Ollama instead (no key needed):
# AI_PROVIDER=openai
# AI_MODEL=llama3.2
# AI_BASE_URL=http://localhost:11434/v1
